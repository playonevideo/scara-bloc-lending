APP_NAME="Vecini"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Bucharest
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ro_RO

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
#
# Production uses MySQL. For local development without a MySQL server you can
# use SQLite (the driver ships with PHP) by setting DB_CONNECTION=sqlite and
# leaving the other DB_* variables commented out.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=scara_bloc_lending
DB_USERNAME=root
DB_PASSWORD=

# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# WhatsApp / Two-Factor Authentication
#
# SMS_PROVIDER accepts:
#   - "meta"    → WhatsApp Cloud API (recomandat, gratuit)
#   - "twilio"  → WhatsApp prin Twilio
#   - "log"     → dezvoltare (scrie codul în log-ul Laravel)
# ---------------------------------------------------------------------------
SMS_PROVIDER=log

# --- Meta WhatsApp Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=ro
WHATSAPP_API_VERSION=v21.0
# Dezactivează verificarea SSL doar în dezvoltare locală (lipsă CA bundle). În producție lasă true.
WHATSAPP_VERIFY_SSL=true

# --- Twilio WhatsApp (alternativă) ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_FROM=+14155238886
TWILIO_CONTENT_SID=
TWILIO_VERIFY_SSL=true

# Number of digits, lifetime in minutes and maximum attempts for 2FA codes.
SMS_CODE_LENGTH=6
SMS_CODE_EXPIRES_MINUTES=10
SMS_CODE_MAX_ATTEMPTS=5
SMS_CODE_THROTTLE_SECONDS=60

# ---------------------------------------------------------------------------
# WebAuthn / Passkeys
# ---------------------------------------------------------------------------
WEBAUTHN_NAME="Vecini"
WEBAUTHN_ID=localhost
WEBAUTHN_ORIGINS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
